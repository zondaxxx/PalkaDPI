<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ByeDPI" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:statusBarColor">?attr/colorSurfaceContainer</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- PalkaDPI palette: near-black canvas, white accents (see palka/ui/PalkaDesign.kt) -->
        <item name="android:windowBackground">@color/palka_background</item>
        <item name="colorPrimary">#F5F6FA</item>
        <item name="colorOnPrimary">#07070E</item>
        <item name="colorPrimaryContainer">#1E1E26</item>
        <item name="colorOnPrimaryContainer">#F5F6FA</item>
        <item name="colorSecondary">#A8F0BF</item>
        <item name="colorOnSecondary">#07070E</item>
        <item name="colorSecondaryContainer">#1C2A21</item>
        <item name="colorOnSecondaryContainer">#A8F0BF</item>
        <item name="colorTertiary">#A8F0BF</item>
        <item name="android:colorBackground">@color/palka_background</item>
        <item name="colorSurface">@color/palka_background</item>
        <item name="colorOnSurface">#F5F6FA</item>
        <item name="colorOnSurfaceVariant">#ADADB5</item>
        <item name="colorSurfaceContainer">#0E0E13</item>
        <item name="colorSurfaceContainerLow">#0B0B10</item>
        <item name="colorSurfaceContainerHigh">#16161C</item>
        <item name="colorSurfaceContainerHighest">#1C1C23</item>
        <item name="colorOutline">#2A2A33</item>
        <item name="colorOutlineVariant">#1F1F27</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorControlHighlight">?attr/colorSecondaryContainer</item>

        <item name="alertDialogTheme">@style/CustomAlertDialog</item>

        <item name="android:textAppearanceListItem">@style/TextPrimary</item>
        <item name="android:textAppearanceListItemSecondary">@style/TextSummary</item>
        <item name="android:textAppearanceListItemSmall">@style/TextSummary</item>

        <item name="switchPreferenceStyle">@style/App.Preference.SwitchPreference</item>
        <item name="materialCardViewStyle">@style/SmallShadowCard</item>
    </style>

    <style name="AppToolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="android:background">?attr/colorSurfaceContainer</item>
    </style>

    <style name="CircleButton" parent="Widget.Material3.Button.Icon">
        <item name="cornerRadius">60dp</item>
        <item name="android:textSize">0sp</item>
    </style>

    <style name="App.Preference.SwitchPreference" parent="Preference.SwitchPreference.Material">
        <item name="android:widgetLayout">@layout/material_switch</item>
    </style>

    <style name="CustomAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/material_alert</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextPrimary" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextSummary" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textSize">14sp</item>
    </style>
</resources>
